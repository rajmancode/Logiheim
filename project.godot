; Engine configuration file.
; Open this folder with Godot 4.3 or newer.

config_version=5

[application]

config/name="Logiheim"
config/description="Hex strategy map generated from Gaea terrain exports."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[rendering]

anti_aliasing/quality/msaa_3d=2
textures/default_filters/anisotropic_filtering_level=3

[shader_globals]

wind_direction={
"type": "vec2",
"value": Vector2(1, 0)
}
wind_strength={
"type": "float",
"value": 0.3
}
wind_time={
"type": "float",
"value": 0.0
}
cloud_offset={
"type": "vec2",
"value": Vector2(0, 0)
}
cloud_coverage={
"type": "float",
"value": 0.3
}
cloud_height={
"type": "float",
"value": 600.0
}
cloud_scale={
"type": "float",
"value": 0.0016
}
cloud_shadow_strength={
"type": "float",
"value": 0.45
}
sun_direction={
"type": "vec3",
"value": Vector3(0.4, 0.75, 0.5)
}
wetness={
"type": "float",
"value": 0.0
}
flood={
"type": "float",
"value": 0.0
}
